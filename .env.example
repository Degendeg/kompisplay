# Skapa en YouTube Data API v3-nyckel i Google Cloud Console och klistra in den här.
# Kopiera den här filen till ".env" och fyll i din nyckel.
VITE_YOUTUBE_API_KEY=din-api-nyckel-har
# Antal videor som hämtas per sökning.
# Ett lägre värde bråkar inte med quotan som YouTube data API har.
VITE_MAX_RESULTS=10